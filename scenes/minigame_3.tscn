[sub_resource type="GDScript" id="GDScript_qebma"]
script/source = "extends Node2D

@onready var self_area: Area2D = $Area2D

signal zoom

func _ready() -> void:
	self_area.area_entered.connect(_on_area_entered)

func _on_area_entered(area: Area2D) -> void:
	if area.is_in_group(\"Player2\"):
		emit_signal(\"zoom\")
	
"

[sub_resource type="CircleShape2D" id="CircleShape2D_qebma"]

[sub_resource type="GDScript" id="GDScript_4c0c6"]
script/source = "extends Node2D

@onready var self_area: Area2D = $Area2D

signal dezoom

func _ready() -> void:
	self_area.area_entered.connect(_on_area_entered)

func _on_area_entered(area: Area2D) -> void:
	if area.is_in_group(\"Player2\"):
		emit_signal(\"dezoom\")
	
"

[sub_resource type="GDScript" id="GDScript_xy8ut"]
script/source = "extends Node2D

@onready var self_area: Area2D = $Area2D

signal escape

func _ready() -> void:
	self_area.area_entered.connect(_on_area_entered)

func _on_area_entered(area: Area2D) -> void:
	if area.is_in_group(\"Player2\"):
		emit_signal(\"escape\")
"

