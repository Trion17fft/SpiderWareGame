[sub_resource type="GDScript" id="GDScript_vhxdv"]
script/source = "extends Node2D

@onready var cam: Camera2D = $Player2/Camera2D
@onready var zone: Area2D = $zoom_camera/Area2D

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass



# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass
	
func zoom() -> void:
	var tween = create_tween()
	tween.tween_property(cam, \"zoom\", Vector2(8, 8), 0.5)


func dezoom() -> void:
	var tween = create_tween()
	tween.tween_property(cam, \"zoom\", Vector2(5.69, 5.69), 0.5)


func escape() -> void:
	await get_tree().create_timer(0.25).timeout
	$TextureRect/AnimationPlayer.play(\"dooropen\")
	await get_tree().create_timer(1.25).timeout
	
	if Global.minigames_done >= 3: # if you havent completed 3 minigames yet 
		Global.money += 1000
		get_tree().change_scene_to_file(\"res://scenes/done_screen.tscn\")
		
	else:
		Global.money += 1000
		get_tree().change_scene_to_file(\"res://scenes/level_scene.tscn\")
		
"

